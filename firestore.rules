rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's tasks live under /users/{their own uid}/tasks/...
    // This rule says: you may only read or write documents in YOUR OWN
    // tasks subcollection, never anyone else's.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
